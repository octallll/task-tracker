map $status $log_level {
    ~^5     ERROR;
    ~^4     WARN;
    default INFO;
}

map $request_uri $request_path {
    ~^(?<path>[^?]*) $path;
}

log_format json escape=json '{'
    '"@timestamp":"$time_iso8601",'
    '"log.level":"$log_level",'
    '"service.name":"task-tracker-frontend",'
    '"message":"$request_method $request_uri $status",'
    '"http.request.method":"$request_method",'
    '"url.path":"$request_path",'
    '"url.query":"$args",'
    '"http.response.status_code":$status,'
    '"http.response.body.bytes":$body_bytes_sent,'
    '"request_time":$request_time,'
    '"upstream.address":"$upstream_addr",'
    '"upstream.response_time":"$upstream_response_time",'
    '"client.ip":"$remote_addr",'
    '"user_agent.original":"$http_user_agent"'
'}';

server {
    listen ${NGINX_PORT};
    server_name _;

    access_log /var/log/nginx/access.log json;

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
